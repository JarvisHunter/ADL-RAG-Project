# Copy to .env and adjust. Every value here is optional (defaults shown).

# Ollama server. Inside Docker use http://host.docker.internal:11434 to reach Ollama on the host.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Bearer token if the server is protected (LLM_API_KEY is also accepted). Leave empty otherwise.
OLLAMA_API_KEY=

# Models (pull them first: `ollama pull <name>`)
RAG_LLM_MODEL=qwen2.5:0.5b
RAG_EMBED_MODEL=nomic-embed-text
RAG_TEMPERATURE=0.2

# Documents and vector store (relative paths are resolved from source_code/)
RAG_DATA_DIR=data/handbook
RAG_VECTOR_STORE_DIR=vector_store
RAG_COLLECTION=rag_documents

# Chunking
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

# Retrieval
RAG_TOP_K=5
# Minimum cosine similarity for a chunk to be used. Leave unset for the calibrated default
# (0.55 for mxbai-embed-large, 0.3 otherwise).
# RAG_SCORE_THRESHOLD=0.3
RAG_ALLOW_GENERAL_KNOWLEDGE=false

# Number of previous question/answer pairs sent to the model
RAG_HISTORY_TURNS=3
